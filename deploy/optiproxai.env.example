# OptiProxAI service environment (systemd EnvironmentFile).
# Install to /etc/optiproxai/optiproxai.env, owned root:optiproxai, mode 640.
# Config resolves ${VAR} from the process environment ONLY; missing vars
# silently become "".
#
# NOTE: systemd EnvironmentFile treats only whole lines beginning with '#' or
# ';' as comments. An inline '#' suffix becomes part of the value, so keep every
# description on its own line above the assignment.

# --- Required at runtime ---
# All routed models
DOUBLEWORD_API_KEY=CHANGEME
# embedding.mode: api -> voyage-4
VOYAGE_API_KEY=CHANGEME

# --- Referenced by config.yaml; only used for offline work / unused providers ---
# feature_annotator (offline dataset annotation)
MISTRAL_API_KEY=CHANGEME
# provider declared, not used by any profile
CHARM_API_KEY=CHANGEME
# provider declared, not used by any profile
OLLAMA_API_KEY=CHANGEME
# provider declared, not used by any profile
SYNTHETIC_API_KEY=CHANGEME

# --- Admin token for POST /admin/reload-config (generate: openssl rand -hex 32) ---
OPTIPROXAI_ADMIN_TOKEN=CHANGEME

# --- State paths (must match ReadWritePaths in the systemd unit) ---
OPTIPROXAI_LOG_DIR=/var/log/optiproxai
OPTIPROXAI_DATA_DIR=/var/lib/optiproxai
