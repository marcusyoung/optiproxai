# OptiProxAI service environment (systemd EnvironmentFile).
# Install to /etc/optiproxai/optiproxai.env, owned root:optiproxai, mode 640.
# Config resolves ${VAR} from the process environment ONLY; missing vars
# silently become "".

# --- Required at runtime ---
DOUBLEWORD_API_KEY=CHANGEME          # all routed models
VOYAGE_API_KEY=CHANGEME              # embedding.mode: api -> voyage-4

# --- Referenced by config.yaml; only used for offline work / unused providers ---
MISTRAL_API_KEY=CHANGEME             # feature_annotator (offline dataset annotation)
CHARM_API_KEY=CHANGEME               # provider declared, not used by any profile
OLLAMA_API_KEY=CHANGEME              # provider declared, not used by any profile
SYNTHETIC_API_KEY=CHANGEME           # provider declared, not used by any profile

# --- Admin token for POST /admin/reload-config (generate: openssl rand -hex 32) ---
OPTIPROXAI_ADMIN_TOKEN=CHANGEME

# --- State paths (must match ReadWritePaths in the systemd unit) ---
OPTIPROXAI_LOG_DIR=/var/log/optiproxai
OPTIPROXAI_DATA_DIR=/var/lib/optiproxai
